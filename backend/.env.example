# EduSphere API configuration. Copy to backend/.env and adjust.
# Real environment variables always win over this file.

NODE_ENV=development
# The address the API listens on. In development the web app's dev server forwards to it, so
# loopback is enough. Use 0.0.0.0 in a container or when a reverse proxy runs on another machine.
HOST=127.0.0.1
PORT=4000

# PostgreSQL 14 or newer. No database server at hand? `npm run db:embedded` starts one on port 5433.
# A hosted database usually ends its URL with ?sslmode=require: the connection is then encrypted
# and the server's certificate is checked. Use sslmode=no-verify only for a self-signed server.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/edusphere
# When DATABASE_URL goes through a connection pooler (Neon, Supabase …), give the direct address
# here; migrations use it. DATABASE_URL_UNPOOLED and POSTGRES_URL_NON_POOLING are read as well.
#DIRECT_URL=
# Most connections one process keeps open (default 15), and how long an unused one is kept.
#DATABASE_POOL_MAX=15
#DATABASE_POOL_IDLE_MS=30000

# This project runs Prisma with its JavaScript engines (no native binary downloads).
PRISMA_SCHEMA_ENGINE=js
CHECKPOINT_DISABLE=1

# Public URL of the web app: used in e-mail links, QR codes and as a trusted origin.
APP_URL=http://localhost:5173
# Extra origins that may call the API with credentials (comma separated). Usually empty.
CORS_ORIGINS=
# Behind a reverse proxy or load balancer set this to "true" or the number of proxy hops.
TRUST_PROXY=false

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=168
# auto = Secure cookies whenever the request arrived over HTTPS.
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax
COOKIE_PARTITIONED=false
# Who may embed the app in a frame (Content-Security-Policy frame-ancestors). Keep 'self'.
FRAME_ANCESTORS="'self'"
# scrypt work factor (N = 2^cost). 15 is a sound production value; 12 keeps development fast.
PASSWORD_HASH_COST=15

# ── Files ───────────────────────────────────────────────────────────────────
# Uploads are stored outside the web root and served only through permission-checked routes.
# STORAGE_DRIVER=disk keeps them in STORAGE_DIR. STORAGE_DRIVER=database keeps them in PostgreSQL,
# for hosts whose disk does not survive a restart; STORAGE_DIR then only holds temporary files.
#STORAGE_DRIVER=disk
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
# Total space for uploads in megabytes; 0 = no limit. With the database driver the default is 300.
#STORAGE_QUOTA_MB=0
# Photos (JPEG, PNG, WebP) above this size are made smaller in the browser before they are sent:
# at most 2048 pixels on the long side, saved as JPEG. By default only a photo over MAX_UPLOAD_MB is
# touched; with the database driver the default is 1. 0 = never.
#REDUCE_PHOTOS_OVER_MB=25

# Serve the built web app (frontend/dist) from this server — single-port production deployments.
SERVE_FRONTEND=false
# Background jobs (auto-submit quizzes, close attendance, scheduled publishing, reminders).
# With several API instances, enable this on exactly one of them.
SCHEDULER_ENABLED=true
# Live updates over WebSockets. Switch off behind a proxy that cannot pass them on; the web app
# then refreshes its live screens on a timer.
#REALTIME_ENABLED=true

# ── Hosting without a server that stays up (docs/DEPLOYMENT.md, "Vercel and Neon") ───────────
# On Vercel all of this is set by itself; nothing here needs to be filled in.
# SERVERLESS=true: background jobs run when requests come in, no WebSockets, files in the
# database, uploads of at most 4 MB.
#SERVERLESS=false
# GET /api/internal/cron runs every background job when called with "Authorization: Bearer <this>".
#CRON_SECRET=

# ── E-mail (optional) ───────────────────────────────────────────────────────
# Without SMTP, verification and password-reset e-mails are captured in memory and can be read
# at GET /api/dev/mailbox — in development only, and only from the computer the API runs on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EduSphere <no-reply@example.edu>"

# ── Map tiles for the attendance geofence picker (optional) ─────────────────
# The picker also works without tiles: coordinates can be typed or taken from the device.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"

# ── AI-assisted authoring (optional) ────────────────────────────────────────
# Any OpenAI-compatible chat-completions API. Without a key the AI features answer
# "not set up" — nothing is simulated. The key never leaves the server.
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=8000
# For the usage report only (USD per 1,000 tokens).
AI_INPUT_COST_PER_1K=0
AI_OUTPUT_COST_PER_1K=0

# ── Code judge for programming exercises (optional) ─────────────────────────
# Student code is never executed by EduSphere itself. Point this at a sandboxed, Piston-compatible
# judge (https://github.com/engineer-man/piston), e.g. http://judge.internal:2000/api/v2
CODE_RUNNER_PROVIDER=none
CODE_RUNNER_URL=
CODE_RUNNER_API_KEY=
CODE_RUNNER_TIMEOUT_MS=30000

# ── First administrator (used once by `npm run db:seed`) ─────────────────────
# Created only when no administrator exists; must change the password at first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
