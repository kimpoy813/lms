// EduSphere — PostgreSQL schema (Prisma ORM)
//
// Conventions
//   • Every timestamp is `timestamptz(3)` so comparisons with now() are timezone-safe.
//   • Academic records (submissions, attempts, grades, attendance) reference their parents with
//     `onDelete: Restrict`. Parents are archived / soft-deleted (`deletedAt`), never hard-deleted,
//     so records stay traceable. Pure configuration rows use `Cascade`.
//   • Users are never deleted. Privacy erasure requests are handled by anonymising the row
//     (see docs/SECURITY-PRIVACY.md), which keeps academic records intact.
//   • Student GPS coordinates are never stored — only the server-computed distance and the
//     reported accuracy (data minimisation, RA 10173).

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// Prisma 6 requires `url` here. At runtime the connection is made by the pg driver adapter
// (src/db/prisma.js); for the CLI, prisma.config.js supplies the same DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

